# Managed by Ansible — do not edit manually.

global_defs {
    router_id {{ keepalived_router_id }}
    enable_script_security
}

vrrp_script chk_haproxy {
    script "{{ keepalived_haproxy_check_command }}"
    interval {{ keepalived_haproxy_check_interval }}
    timeout {{ keepalived_haproxy_check_timeout }}
    fall {{ keepalived_haproxy_check_fall }}
    rise {{ keepalived_haproxy_check_rise }}
    weight {{ keepalived_haproxy_check_weight }}
    user root
}

vrrp_instance VI_API {
    state {{ keepalived_state }}
    interface {{ load_balancer_interface }}
    virtual_router_id {{ keepalived_virtual_router_id }}
    priority {{ keepalived_priority }}
    advert_int {{ keepalived_advert_int }}
    version {{ keepalived_vrrp_version }}

    track_script {
        chk_haproxy
    }

    virtual_ipaddress {
        {{ load_balancer_vip }}/{{ load_balancer_vip_cidr }} dev {{ load_balancer_interface }}
    }
}
