#!/usr/bin/env bash
set -euo pipefail

BACKUP_DIR="{{ etcd_backup_dir }}"
ENDPOINT="{{ etcd_backup_endpoint }}"
CA_CERT="{{ etcd_backup_ca_cert }}"
CERT="{{ etcd_backup_cert }}"
KEY="{{ etcd_backup_key }}"
RETENTION_DAYS="{{ etcd_backup_retention_days }}"
REQUIRE_MOUNT="{{ 'true' if (etcd_backup_require_mount | bool or etcd_backup_use_nfs | bool) else 'false' }}"
NODE_NAME="${NODE_NAME:-$(hostname -s 2>/dev/null || hostname)}"
# Cluster PKI archive (DR plan, gap T1). Encrypted to a public key whose
# private half is held offline; empty PKI_RECIPIENT disables it.
PKI_DIR="{{ etcd_backup_pki_dir }}"
PKI_RECIPIENT="{{ etcd_backup_pki_recipient_path }}"
PKI_FILES="{{ etcd_backup_pki_files | join(' ') }}"

# Record the outcome of every attempt for monitoring (backup success KPI).
# The status file lives next to the snapshots so the host collector sees it.
STATUS_FILE="${BACKUP_DIR}/.etcd-backup-status-${NODE_NAME}"
write_status() {
  local rc=$?
  local ok=0
  [ "$rc" -eq 0 ] && ok=1
  printf '%s %s\n' "$(date +%s)" "$ok" >"${STATUS_FILE}.tmp" && mv "${STATUS_FILE}.tmp" "${STATUS_FILE}" || true
}
trap write_status EXIT

# Prevent overlapping control-plane timers from writing duplicate snapshots at
# the same time when they share an external backup directory.
LOCK_FILE="${BACKUP_DIR}/.etcd-backup.lock"
exec 9>"${LOCK_FILE}"
# Wait for the other node rather than skipping, so every node's hourly
# attempt is recorded. A lock held for 2 minutes is reported as a failure.
if ! flock -w 120 9; then
  echo "ERROR: another etcd backup held the lock for 120 s." >&2
  exit 1
fi

DATE=$(date -u +"%Y%m%d_%H%M%SZ")
SNAPSHOT_FILE="${BACKUP_DIR}/etcd-snapshot-${NODE_NAME}-${DATE}.db"

# Safety check: if external mount is required, ensure target is a valid mount point
if [ "${REQUIRE_MOUNT}" = "true" ]; then
  if ! mountpoint -q "${BACKUP_DIR}"; then
    echo "ERROR: Backup directory ${BACKUP_DIR} is not a mount point and external storage is required." >&2
    exit 1
  fi
fi

echo "[$(date -u)] Starting etcd backup for node '${NODE_NAME}' to ${SNAPSHOT_FILE}..."

# Check certificates exist
for f in "${CA_CERT}" "${CERT}" "${KEY}"; do
  if [ ! -f "$f" ]; then
    echo "ERROR: Required certificate or key $f does not exist." >&2
    exit 1
  fi
done

# Perform snapshot using etcdctl
/usr/local/bin/etcdctl \
  --endpoints="${ENDPOINT}" \
  --cacert="${CA_CERT}" \
  --cert="${CERT}" \
  --key="${KEY}" \
  snapshot save "${SNAPSHOT_FILE}"

# Set permissions
chmod 0600 "${SNAPSHOT_FILE}"

# Verify snapshot integrity using etcdutl or etcdctl
if command -v /usr/local/bin/etcdutl >/dev/null 2>&1; then
  echo "[$(date -u)] Verifying snapshot with etcdutl..."
  /usr/local/bin/etcdutl snapshot status "${SNAPSHOT_FILE}" --write-out=table
elif command -v /usr/local/bin/etcdctl >/dev/null 2>&1; then
  echo "[$(date -u)] Verifying snapshot with etcdctl..."
  ETCDCTL_API=3 /usr/local/bin/etcdctl snapshot status "${SNAPSHOT_FILE}" --write-out=table
fi

# Without the cluster CA and service-account signing key, a snapshot restores
# into a cluster with a new identity: every token and kubeconfig breaks.
if [ -n "${PKI_RECIPIENT}" ]; then
  if [ ! -r "${PKI_RECIPIENT}" ]; then
    echo "ERROR: PKI recipient key ${PKI_RECIPIENT} is not readable." >&2
    exit 1
  fi
  PKI_FILE="${BACKUP_DIR}/cluster-pki-${NODE_NAME}-${DATE}.tar.gpg"
  GNUPGHOME_TMP="$(mktemp -d)"
  # shellcheck disable=SC2086  # PKI_FILES is a space-separated list
  tar -C "${PKI_DIR}" -cf - ${PKI_FILES} |
    gpg --batch --no-tty --quiet --homedir "${GNUPGHOME_TMP}" --trust-model always \
      --recipient-file "${PKI_RECIPIENT}" --encrypt --output "${PKI_FILE}.tmp"
  rm -rf "${GNUPGHOME_TMP}"
  chmod 0600 "${PKI_FILE}.tmp"
  mv "${PKI_FILE}.tmp" "${PKI_FILE}"
  echo "[$(date -u)] Encrypted cluster PKI written to ${PKI_FILE}"
fi

# Prune old snapshots for this specific node exceeding retention policy
echo "[$(date -u)] Pruning snapshots for node '${NODE_NAME}' older than ${RETENTION_DAYS} days..."
find "${BACKUP_DIR}" -type f -name "etcd-snapshot-${NODE_NAME}-*.db" -mtime +"${RETENTION_DAYS}" -print -delete
find "${BACKUP_DIR}" -type f -name "cluster-pki-${NODE_NAME}-*.tar.gpg" -mtime +"${RETENTION_DAYS}" -print -delete

echo "[$(date -u)] etcd backup completed successfully."
