apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ vault_token_reviewer_serviceaccount }}
  namespace: {{ vault_token_reviewer_namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: vault-token-reviewer
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: system:auth-delegator
subjects:
  - kind: ServiceAccount
    name: {{ vault_token_reviewer_serviceaccount }}
    namespace: {{ vault_token_reviewer_namespace }}
