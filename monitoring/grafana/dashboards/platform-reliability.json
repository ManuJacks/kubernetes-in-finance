      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(sli:api_availability:error_ratio_rate6h) / 0.001",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true
